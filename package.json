{
  "name": "one_shift_web_game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pack:zip": "rm -f one-shift-playable.zip && npm run build && cd dist && zip -9 -r ../one-shift-playable.zip . -x '.*'",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
